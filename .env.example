# Ghost Game Zone Production Environment Variables

# Supabase Production Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Note: If Supabase env vars are omitted, the app automatically runs out-of-the-box
# using a zero-dependency local JSON filesystem database in /data/ghost_game_zone_db.json
